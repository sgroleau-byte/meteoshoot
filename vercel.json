{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/scene3d.js": {
      "maxDuration": 90
    },
    "api/terrain.js": {
      "maxDuration": 60
    },
    "api/horizon.js": {
      "maxDuration": 60
    },
    "api/goes.js": {
      "maxDuration": 30
    },
    "api/metar.js": {
      "maxDuration": 20
    },
    "api/verif-snapshot.js": {
      "maxDuration": 120,
      "includeFiles": "src/weather/blendModel.json"
    },
    "api/om.js": {
      "maxDuration": 60
    }
  },
  "github": {
    "silent": true
  },
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      },
      "continue": true
    },
    {
      "src": "/(.*)\\.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dieu.meteoshoot.com"
        }
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "dieu.meteoshoot.com"
        }
      ],
      "dest": "/site/dieu.html"
    },
    {
      "src": "/((?!assets/|fonts/|imgProjet/|site/dieu\\.html$|favicon|icon-|apple-touch-icon|manifest\\.json$).+)",
      "has": [
        {
          "type": "host",
          "value": "dieu.meteoshoot.com"
        }
      ],
      "dest": "/introuvable"
    },
    {
      "src": "/site/dieu\\.html",
      "missing": [
        {
          "type": "host",
          "value": "dieu.meteoshoot.com"
        }
      ],
      "dest": "/introuvable"
    }
  ]
}
