{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/scene3d.js": {
      "maxDuration": 90
    },
    "api/terrain.js": {
      "maxDuration": 60
    },
    "api/horizon.js": {
      "maxDuration": 60
    },
    "api/goes.js": {
      "maxDuration": 30
    },
    "api/metar.js": {
      "maxDuration": 20
    },
    "api/verif-snapshot.js": {
      "maxDuration": 120,
      "includeFiles": "src/weather/blendModel.json"
    }
  },
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
